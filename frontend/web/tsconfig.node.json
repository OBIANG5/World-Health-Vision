{
  // Ce fichier est responsable de:
  // - definir les options TypeScript pour les fichiers executes cote Node
  // - typer et verifier la configuration Vite
  // - separer le contexte tooling du contexte application web
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Mode bundler */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Regles de qualite */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // Scope volontairement limite aux fichiers de configuration build.
  "include": ["vite.config.ts"]
}

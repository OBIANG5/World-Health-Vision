{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    // Shared CreativeEdit lives outside this Vite app. TypeScript normally
    // walks upwards from the original file and misses web-v2/node_modules.
    // Explicit paths keep one set of player types; Vite resolve.dedupe keeps
    // one React/runtime at execution time.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "remotion": ["./node_modules/remotion"],
      "@remotion/transitions": ["./node_modules/@remotion/transitions"],
      "@remotion/transitions/fade": ["./node_modules/@remotion/transitions/dist/presentations/fade.d.ts"],
      "@remotion/transitions/slide": ["./node_modules/@remotion/transitions/dist/presentations/slide.d.ts"],
      "@remotion/layout-utils": ["./node_modules/@remotion/layout-utils"],
      "d3-geo": ["./node_modules/d3-geo"],
      "topojson-client": ["./node_modules/topojson-client"],
      "world-atlas/*": ["./node_modules/world-atlas/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
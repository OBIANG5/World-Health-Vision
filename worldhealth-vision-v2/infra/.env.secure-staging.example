# Template only. Never commit a completed .env or secret/password.
# Load with: docker compose --env-file /your/private/whv.env -f infra/compose.secure-staging.yml ...
# Use a vetted, immutable sha256 digest from an approved TimescaleDB image.
WHV_TIMESCALE_IMAGE=timescale/timescaledb@sha256:REPLACE_WITH_REAL_VERIFIED_64_HEX_DIGEST
# Secret must be a readable, non-empty absolute-path file OUTSIDE the repo:
WHV_DB_PASSWORD_FILE=/srv/worldvision/secrets/timescaledb-password
# A trusted, live issuer is required; the current gateway protects every GET /api route.
WHV_OIDC_ISSUER_URI=https://YOUR_AUTH_PROVIDER.example/realms/worldvision
# Loopback only; configure your reverse proxy separately AFTER security review.
WHV_GATEWAY_HOST_PORT=18080
# Backups must be outside Git and synchronised to encrypted offsite storage.
WHV_BACKUP_DIR=/var/backups/worldvision
